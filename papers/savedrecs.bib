@article{ WOS:001918293200033,
Author = {Ismail, Mohamed I. and Khaled, Adel and Nafea, Sherif F. and Shaheen,
   Abdullah M. and Fouda, Mostafa and Alwakeel, Ahmed S.},
Title = {Multiobjective Modeling and Optimization of Reconfigurable Intelligent
   Surface-Aided Multiuser Wireless Communications},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {18},
Pages = {43333-43348},
Month = {SEP 15},
Abstract = {Reconfigurable intelligent surface (RIS) has emerged as a promising
   solution for improving wireless communication by intelligently adapting
   the propagation environment. However, identifying the optimum number and
   placement of RISs remains challenging. Practical installation limits and
   the need to balance system performance and investment cost complicate
   this process. Existing research often focuses on increasing achievable
   rates but does not effectively address these constraints. As a result,
   there is a gap in the field of realistic and efficient RIS optimization.
   To address this gap, we present a multiobjective optimization approach.
   This approach reduces the number of deployed RISs while increasing the
   achievable rate, subject to practical placement restrictions. We develop
   a bonobo optimizer (BO) that efficiently balances exploration and
   exploitation in complex search spaces. We also examine how different
   achievable rate threshold settings affect model performance. The
   findings indicate that the BO algorithm achieves the highest achievable
   rate with the fewest RISs. Furthermore, a comparative analysis is
   presented between the developed BO algorithm and differential evolution
   (DE), Bernstein-Levy search DE (BSDE), DE/best/1 (DE3), fuzzy
   self-tuning DE (FSDE), weighted DE (WDE), genetic algorithm (GA),
   particle swarm optimization (PSO), and Gray Wolf optimizer (GWO). The
   simulation results demonstrate the significant applicability of the
   developed BO algorithm in achieving the lowest number of RISs under
   various feasible rate threshold settings. When BO is compared to
   standard DE, BSDE, DE3, FSDE, and WDE, the minimum objective function at
   an achievable rate threshold equal to 1 is improved by 23.12\%, 15.31\%,
   8.82\%, 19.60\%, and 8.65\%, respectively.},

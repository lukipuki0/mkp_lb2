@article{ WOS:001906373700001,
Author = {Okubanjo, Ayodeji Akinsoji and Okakwu, Ignatius Kema},
Title = {Optimal design of hybrid microgrids for sustainable electrification
   using the black widow optimization algorithm},
Journal = {NEXT ENERGY},
Year = {2026},
Volume = {13},
Month = {OCT},
Abstract = {The optimal design of hybrid microgrid systems present substantial
   computational complexity for existing optimization methods, such as the
   Genetic Algorithm (GA), Particle Swarm Optimization (PSO), Differential
   Evolution (DE), Grey Wolf Optimizer (GWO), and Ant Lion Optimizer, often
   leads to rapid convergence and low optimization accuracy. To address
   this limitation, this study proposes a Black Widow Optimization (BWO)
   based framework for optimal sizing and techno-economic analysis of a
   photovoltaic-wind-hydrogen -battery microgrid. The BWO algorithm
   enhances search efficiency via a mating and cannibalism-inspired
   mechanism that improves population density, strengthens global
   population, ensures effective convergence. Results demonstrate that the
   BWO-based model outperforms GA, PSO, DE, GWO, and ALO in terms of NPC,
   COE, and renewable fraction, while also achieving faster convergence,
   improved solution quality, and higher robustness. Results show that the
   PV/WT/MH/BAT configuration achieved an LCOE of \$0.275/kWh and an NPC of
   \$380,000, outperforming HOMER-based models in cost and efficiency. The
   integration of wind and hydro resources improved reliability during low
   solar periods, ensuring uninterrupted power supply, while comparisons
   with HOMER simulations and prior studies confirmed the BWO algorithm's
   robustness and superior optimization performance. These findings
   demonstrate that BWO-optimized hybrid systems offer a practical
   framework for decentralized low-carbon electrification and support
   policy formulation, green financing, and large-scale rural energy
   deployment in Nigeria.},

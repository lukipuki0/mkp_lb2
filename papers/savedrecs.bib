@article{ WOS:001851737100001,
Author = {Liu, Hang and Li, Benyou and Liu, Zhijian and Li, Qing and Wang, Youyuan
   and Zhang, Zuxin and Leng, Yuxiang},
Title = {Short-term multi-energy load forecasting for integrated energy systems
   based on an improved graph multi-attention network},
Journal = {RESULTS IN ENGINEERING},
Year = {2026},
Volume = {32},
Month = {DEC},
Abstract = {Accurate short-term forecasting of electricity, cooling, and heating
   loads is important for the efficient operation of integrated energy
   systems (IES). However, existing methods still have limitations in
   identifying load-meteorological coupling relationships and capturing
   cross-energy temporal dependencies. To address these issues, this paper
   proposes an optimized graph multi-attention network (GMAN) for
   short-term multi-energy load forecasting. At the input level, the mutual
   information coefficient (MIC) and Chatterjee's xi correlation
   coefficient are combined to quantify nonlinear relationships between
   meteorological variables and different energy loads, and time-encoded
   variables and historical load statistical features are integrated to
   construct multidimensional inputs. At the model level, efficient
   additive attention (EAA) is introduced to enhance temporal dependency
   extraction, and a STar aggregate-redistribute (STAR) module is embedded
   to strengthen channel interaction and improve channel-wise information
   filtering. An uncertainty-adaptive multi-task loss function is designed
   to balance electricity, cooling, and heating forecasting tasks, while a
   differential evolution-enhanced grey wolf optimizer (DEGWO) is used for
   hyperparameter optimization. Experiments on measured data from Arizona
   State University show that, over five independent runs, the proposed
   method reduces the average mean absolute percentage error (MAPE) by
   5.384, 6.521, and 8.583 percentage points for electricity, cooling, and
   heating load forecasting, respectively, compared with a basic GMAN
   baseline using only historical electricity, cooling, and heating loads
   as inputs. Statistical significance analysis, cross-year and
   cross-season validation on the HEEW dataset, and multi-step forecasting
   experiments further verify the generalization ability and robustness of
   the proposed method.},
